{
  "scopeName": "source.beebasm",
  "name": "BeebAsm",
  "patterns": [
    { "name": "comment.line.beebasm", "match": "[\\\;].*$" },
    { "name": "string.quoted.double.beebasm", "begin": "\"", "end": "\"" },
    { "name": "entity.name.function.label.beebasm", "match": "\\.[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "keyword.control.directive.beebasm", "match": "(?i)\\b(org|cpu|skip|skipto|align|include|incbin|equb|equw|equd|equs|mapchar|guard|clear|save|print|error|for|next|if|elif|else|endif|macro|endmacro|copyblock|randomize|assert|putfile|puttext|putbasic)\\b" },
    { "name": "keyword.mnemonic.beebasm", "match": "(?i)\\b(adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|bra|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|phx|phy|pla|plp|plx|ply|rol|ror|rti|rts|sbc|sec|sed|sei|sta|stx|sty|stz|tax|tay|trb|tsb|tsx|txa|txs|tya)\\b" },
    { "name": "constant.numeric.hex.beebasm", "match": "&[0-9A-Fa-f]+|\\$[0-9A-Fa-f]+" },
    { "name": "constant.numeric.binary.beebasm", "match": "%[01]+" },
    { "name": "constant.numeric.decimal.beebasm", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
  ]
}
