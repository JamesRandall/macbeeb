{
  "scopeName": "source.ca65",
  "name": "ca65",
  "patterns": [
    { "name": "comment.line.semicolon.ca65", "match": ";.*$" },
    { "name": "string.quoted.double.ca65", "begin": "\"", "end": "\"" },
    { "name": "entity.name.function.label.ca65", "match": "^\\s*[A-Za-z_@][A-Za-z0-9_@]*:" },
    { "name": "keyword.control.directive.ca65", "match": "(?i)\\.[a-z]+\\b" },
    { "name": "keyword.mnemonic.ca65", "match": "(?i)\\b(adc|and|asl|bcc|bcs|beq|bit|bmi|bne|bpl|bra|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|phx|phy|pla|plp|plx|ply|rol|ror|rti|rts|sbc|sec|sed|sei|sta|stx|sty|stz|tax|tay|trb|tsb|tsx|txa|txs|tya)\\b" },
    { "name": "constant.numeric.hex.ca65", "match": "\\$[0-9A-Fa-f]+|&[0-9A-Fa-f]+" },
    { "name": "constant.numeric.binary.ca65", "match": "%[01]+" },
    { "name": "constant.numeric.decimal.ca65", "match": "\\b[0-9]+\\b" }
  ]
}
